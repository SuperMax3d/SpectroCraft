# bump_version.cmake - run on every build (via the sc_bump_version target).
#
# 1. Reads VERSION.txt from the source root (seeds it with 1.0.0 if missing),
#    increments the patch number and writes it back, so every compile gets a
#    fresh version: first build = 1.0.0, then 1.0.1 -> 1.0.2 ...
# 2. Generates <build>/generated/Version.h with SC_VERSION_STRING for the
#    About box / unit tests.
# 3. Writes <build>/generated/SC_VERSION.txt so patch_generated.cmake can apply
#    the same version to JUCE's generated resources.rc and JuceHeader.h.
# 4. Deletes the "patched" stamp file so the sc_patch_generated custom command
#    re-runs on this build (it patches the generated files in place).

cmake_minimum_required(VERSION 3.22)

# SC_SOURCE_DIR is passed in via -DSC_SOURCE_DIR=...
set(GEN_DIR       "${CMAKE_BINARY_DIR}/generated")
set(VERSION_FILE  "${SC_SOURCE_DIR}/VERSION.txt")
set(STAMP_FILE    "${GEN_DIR}/generated_patched.stamp")

file(MAKE_DIRECTORY "${GEN_DIR}")

# --- read / seed the version ---------------------------------------------
# First build on a fresh checkout uses 1.0.0; every later build increments
# the patch number.
if(EXISTS "${VERSION_FILE}")
    file(STRINGS "${VERSION_FILE}" old_version LIMIT_COUNT 1)
    string(STRIP "${old_version}" old_version)
    if(NOT old_version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
        message(WARNING "SpectroCraft: VERSION.txt contains '${old_version}', reseeding to 1.0.0")
        set(old_version "1.0.0")
    endif()

    string(REGEX MATCHALL "[0-9]+" version_parts "${old_version}")
    list(GET version_parts 0 sc_maj)
    list(GET version_parts 1 sc_min)
    list(GET version_parts 2 sc_pat)
    math(EXPR sc_pat "${sc_pat} + 1")
    set(new_version "${sc_maj}.${sc_min}.${sc_pat}")
    message(STATUS "SpectroCraft version: ${old_version} -> ${new_version}")
else()
    set(old_version "-")
    set(new_version "1.0.0")
    message(STATUS "SpectroCraft version: seeded 1.0.0 (first build)")
endif()

file(WRITE "${VERSION_FILE}" "${new_version}\n")

# --- Version.h for the About box ------------------------------------------
string(REPLACE "." ";" vparts "${new_version}")
list(GET vparts 0 sc_maj)
list(GET vparts 1 sc_min)
list(GET vparts 2 sc_pat)

file(WRITE "${GEN_DIR}/Version.h"
"#pragma once
// Auto-generated by cmake/bump_version.cmake - do not edit.
#define SC_VERSION_STRING \"${new_version}\"
#define SC_VERSION_MAJOR  ${sc_maj}
#define SC_VERSION_MINOR  ${sc_min}
#define SC_VERSION_PATCH  ${sc_pat}
")

# --- version file for the rc/header patcher ---------------------------------
file(WRITE "${GEN_DIR}/SC_VERSION.txt" "${new_version}\n")

# --- force the in-place patch to run again this build -----------------------
if(EXISTS "${STAMP_FILE}")
    file(REMOVE "${STAMP_FILE}")
endif()
