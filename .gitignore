# Build output (root-level only — JUCE has its own extras/Build dir)
/build/
/out/
cmake-build-*/
*.user
.vs/
.idea/

# Compiler artifacts
*.obj
*.o
*.pdb
*.ilk
*.idb
*.exp
*.lib
# ...except the vendored OpenVINO import library (required for linking)
!extern/OpenVINO/lib/openvino.lib
# ...and the vendored FFmpeg import libraries
!extern/ffmpeg/lib/*.lib

# OS junk
Thumbs.db
desktop.ini
.DS_Store
/VERSION.txt

# FFmpeg rebuild scratch dirs (extern/ffmpeg/build.sh)
/extern/ffmpeg/_build/
/extern/ffmpeg/_native/

# Local test builds are no longer distributed via the repo (GitHub Releases
# from CI ship them instead); keep a local build for testing.
/bin/

# MCP adapter (tools/mcp): local Claude Code config and Python artefacts
/.mcp.json
/tools/mcp/.venv/
/tools/mcp/uv.lock
/tools/mcp/*.egg-info/
__pycache__/
.pytest_cache/
