spectrocraft-update-key/1
# SpectroCraft update-manifest signing key (development key, Windows builds).
#
# seed   = the private Ed25519 seed. This is the secret: whoever holds it can
#          publish an update every SpectroCraft build will accept.
# public = the key built into the app (sc::update::manifestPublicKeyHex in
#          include/Updates.h). spectrocraft-updater --public <this file>
#          recomputes it from the seed and must print exactly that value.
#
# tests/regression/updates.inc checks the pairing, so a key that no longer
# matches the app fails the test suite.
#
# To rotate the key: generate a new seed, put the new public key in
# include/Updates.h, keep the old file as ed25519.key.<n> so old releases can
# still be verified, and sign new releases with the new key.
seed=7e3f1c9a5b2d84e60f1a7c3d9e2b648a1d0c5f8b3a6e9d247c1b0a8f5e6d3c29
public=36901732a161bef50ac2710016efe240c15935e04f1e356aab3ec5f33bff23da
