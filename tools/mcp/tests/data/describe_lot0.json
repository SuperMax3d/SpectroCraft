  {
   "id": "journal.read",
   "aliases": [],
   "title": "Read the session journal (commands, steps, undo/redo, jobs)",
   "category": "journal",
   "flags": [
    "Query"
   ],
   "params": {
    "type": "object",
    "properties": {
     "sinceSeq": {
      "type": "integer",
      "minimum": 0.0,
      "default": 0
     },
     "kinds": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "command|step|history|job|meta|doc|alert"
     },
     "limit": {
      "type": "integer",
      "minimum": 1.0,
      "maximum": 10000.0,
      "default": 200
     },
     "docId": {
      "type": "integer",
      "minimum": 0.0,
      "description": "Only entries of this document"
     }
    },
    "additionalProperties": false
   },
   "result": {
    "type": "object"
   }
  },
  {
   "id": "history.list",
   "aliases": [],
