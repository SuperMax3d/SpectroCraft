  {
   "id": "doc.saveAs",
   "aliases": [],
   "title": "Save the document to a new path (audio + metadata)",
   "category": "doc",
   "flags": [
    "NeedsDoc",
    "Destructive"
   ],
   "params": {
    "type": "object",
    "properties": {
     "path": {
      "type": "string",
      "description": "Absolute target path (.wav keeps embedded metadata)"
     },
     "meta": {
      "type": "string",
      "enum": [
       "auto",
       "embedded",
       "sidecar"
      ],
      "description": "Metadata storage: keep (auto), RIFF chunks (embedded) or .meta.json (sidecar)",
      "default": "auto"
     },
     "confirm": {
      "type": "boolean",
      "description": "Required when the target exists"
     }
    },
    "required": [
     "path"
    ],
    "additionalProperties": false
   },
   "result": {
    "type": "object"
   }
  },
  {
   "id": "doc.save",
   "aliases": [],
   "title": "Save the document in place (overwrites its file)",
   "category": "doc",
   "flags": [
    "NeedsDoc",
    "Destructive"
   ],
   "params": {
    "type": "object",
    "properties": {
     "meta": {
      "type": "string",
      "enum": [
       "auto",
       "embedded",
       "sidecar"
      ],
      "default": "auto"
     },
     "confirm": {
      "type": "boolean",
      "description": "Required: the file on disk is overwritten"
     }
    },
    "additionalProperties": false
   },
   "result": {
    "type": "object"
   }
  },
  {
   "id": "selection.set",
   "aliases": [
    "select"
   ],
   "title": "Set the time selection (seconds) and optionally the channels edits apply to",
   "category": "selection",
   "flags": [
    "NeedsDoc"
   ],
   "params": {
    "type": "object",
    "properties": {
     "start": {
      "type": "number",
      "minimum": 0.0,
      "description": "Start (s)"
     },
     "end": {
      "type": "number",
      "minimum": 0.0,
      "description": "End (s); end == start clears the range"
     },
     "channels": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 0.0
      },
      "description": "0-based channels edits apply to (also the visible tracks)"
     }
    },
    "required": [
     "start",
     "end"
    ],
    "additionalProperties": false
   },
   "result": {
    "type": "object"
   }
  },
