    ],
    "additionalProperties": false
   },
   "result": {
    "type": "object"
   }
  },
  {
   "id": "step.run",
   "aliases": [],
   "title": "Apply one action step (any of the 20 recorded types) on an explicit range",
   "category": "step",
   "flags": [
    "Mutates",
    "NeedsDoc"
   ],
   "params": {
    "type": "object",
    "properties": {
     "step": {
      "type": "object",
      "properties": {
       "type": {
        "type": "string",
        "description": "Step type, e.g. changeGain, fadeOut, envelope"
       },
       "params": {
        "type": "object",
        "description": "Step parameters (see app.describe category step)"
       },
       "prompt": {
        "type": "boolean",
        "description": "Ignored here (interactive replay only)"
       }
      },
      "required": [
       "type"
      ],
      "additionalProperties": false,
      "description": "{type, params}"
     },
     "select": {
      "oneOf": [
       {
        "type": "string",
        "enum": [
         "all"
        ]
       },
       {
        "type": "object",
        "properties": {
         "start": {
          "type": "number",
          "minimum": 0
         },
         "end": {
          "type": "number",
          "minimum": 0
         }
        },
        "required": [
         "start",
         "end"
        ],
        "additionalProperties": false
       }
      ],
      "description": "\"all\", or {start, end} in seconds (default: current selection)"
     },
     "channels": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 0.0
      },
      "description": "0-based channels the step applies to (default: the visible ones)"
     }
    },
    "required": [
     "step"
    ],
    "additionalProperties": false
   },
   "result": {
    "type": "object"
   }
  },
  {
   "id": "steps.run",
   "aliases": [],
   "title": "Apply several action steps in order",
   "category": "step",
   "flags": [
    "Mutates",
    "NeedsDoc"
   ],
   "params": {
    "type": "object",
    "properties": {
     "steps": {
      "type": "array",
      "items": {
       "type": "object"
      },
      "description": "[{type, params}, ...] - one history entry per step"
     },
     "select": {
      "oneOf": [
       {
        "type": "string",
        "enum": [
         "all"
        ]
       },
       {
        "type": "object",
        "properties": {
         "start": {
          "type": "number",
          "minimum": 0
         },
         "end": {
          "type": "number",
          "minimum": 0
         }
        },
        "required": [
         "start",
         "end"
        ],
        "additionalProperties": false
       }
      ],
      "description": "\"all\", or {start, end} in seconds (default: current selection)"
     },
     "channels": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 0.0
      },
      "description": "0-based channels the step applies to (default: the visible ones)"
     },
     "stopOnError": {
      "type": "boolean",
      "default": true
     }
    },
    "required": [
     "steps"
    ],
    "additionalProperties": false
   },
   "result": {
    "type": "object"
   }
  },
  {
   "id": "step.validate",
   "aliases": [],
   "title": "Check a step without touching any document",
   "category": "step",
   "flags": [
    "Query"
   ],
   "params": {
    "type": "object",
    "properties": {
     "step": {
      "type": "object",
      "properties": {
       "type": {
        "type": "string",
        "description": "Step type, e.g. changeGain, fadeOut, envelope"
       },
       "params": {
        "type": "object",
        "description": "Step parameters (see app.describe category step)"
       },
       "prompt": {
        "type": "boolean",
        "description": "Ignored here (interactive replay only)"
       }
      },
      "required": [
       "type"
      ],
      "additionalProperties": false,
      "description": "{type, params}"
     }
    },
    "required": [
     "step"
    ],
    "additionalProperties": false
   },
   "result": {
    "type": "object"
   }
  },
