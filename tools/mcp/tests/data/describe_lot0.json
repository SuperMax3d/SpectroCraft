    "Query"
   ],
   "params": {
    "type": "object",
    "properties": {
     "includeJournal": {
      "type": "boolean",
      "default": true
     },
     "since": {
      "type": "integer",
      "minimum": 0.0,
      "description": "Journal entries after this seq",
      "default": 0
     }
    },
    "additionalProperties": false
   },
   "result": {
    "type": "object"
   }
  },
  {
