  {
   "id": "doc.meta",
   "aliases": [],
   "title": "Document metadata bundle (markers, selections, calibration, transcription...)",
   "category": "doc",
   "flags": [
    "NeedsDoc",
    "Query"
   ],
   "params": {
    "type": "object",
    "properties": {
