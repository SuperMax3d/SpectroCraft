  {
   "id": "app.describe",
   "aliases": [],
   "title": "Describe every command (JSON Schemas of params)",
   "category": "app",
   "flags": [
    "Query"
   ],
   "params": {
    "type": "object",
    "properties": {
     "category": {
      "type": "string",
      "description": "Only this domain (e.g. \"doc\")"
     },
     "withSchemas": {
      "type": "boolean",
      "description": "Include params/result schemas",
      "default": true
     },
     "includeInternal": {
      "type": "boolean",
      "description": "Include debug helpers",
      "default": false
     }
    },
    "additionalProperties": false
   },
   "result": {
    "type": "object"
   }
